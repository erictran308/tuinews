# Optional overrides, for development only: release builds ignore .env.
# Copy to .env in this source folder (the one with Cargo.toml): development
# builds read it from here, never from the folder they're started in. Only
# TN_* keys are read.

# Where your feeds, history and settings are kept: a full path.
# Default: the platform's app data directory (see `tuinews --help`).
# TN_DATA_DIR=/Users/you/tn-test

# How pictures are drawn: auto, kitty, sixel, iterm2 or blocks.
# TN_IMAGES=blocks
